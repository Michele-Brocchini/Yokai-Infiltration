div(id="lobbyContainer" style="display:none; width:100%; height:100%; overflow:hidden;")
    div(class="ui inverted menu" style="margin-bottom:0px;")
        div(class="ui inverted menu" style="margin-right:auto")
            div(class="header item") Yokai Infiltration
            a(class="item" href="/") Home

        div(class="ui inverted menu" style="margin:auto")
            a(class="item" id="filterAll") All
            a(class="item" id="filterBeginner") Beginner
            a(class="item" id="filterRanked") Ranked
            div(class="ui inverted compact menu")
                    div(class="ui simple dropdown item") Mode
                        i(class="dropdown icon")
                        div(class="ui inverted menu")
                            div(class="item" id="filterOneDay") OneDay
                            div(class="item" id="filterClassic") Classic    

        div(class="inverted right menu")
            include loggedInRightMenu.pug
    div(id="lobby" style="height:calc(100% - 48px);")
        div(id="lobbyContainer" style="display:none; width:100%; height:100%; overflow:hidden;")

    div(class="ui inverted menu lobbyMenu")
        div(class="header item") Yokai Infiltration
        a(class="item" href="/") Home

        div(class="ui inverted right menu")
            include loggedInRightMenu.pug

    div(id="lobby")

        //- Left: available games
        div(id="container")

            div(class="lobbyPanelHeader")
                span Games
                button(
                    id="newGameButton"
                    class="ui blue button"
                    type="submit"
                ) New Game

            div(id="lobbyItemList")
                - var n = numberOfGames - 1;
                - while(n >= 0){
                    +lobbyEntry(n, gameNames[n], players[n], gameInPlay[n], gameTypes[n], uids[n])
                    - n -= 1;
                - }

        //- Right: current lobby
        div(id="lobbyRightBar")

            div(class="lobbyPanelHeader")
                span Lobby

            div(id="lobbyListContainer")
                ul(id="lobbyList")

            div(id="lobbyChatTitleContainer" class="lobbyPanelHeader")
                span Chat

            div(id="lobbyChatListContainer")
                ul(id="lobbyChatList")

            form(id="lobbyChatForm" action="")
                input(
                    id="lobbyChatInput"
                    autocomplete="off"
                    maxlength="280"
                    placeholder="Type a message..."
                )

